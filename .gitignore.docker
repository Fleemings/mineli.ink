# Docker and Container Files to ignore
# Add these lines to your .gitignore file

# Docker
Dockerfile
Dockerfile.prod
Dockerfile.dev
.docker ignore
docker-compose*.yml
.env.docker
.env.docker.prod
.env.prod

# Docker volumes and data
/mongodb_data
/backups
docker_data/

# Docker logs
*.log
docker-compose.log

# Build artifacts
dist/
build/
*.o
*.a

# IDE and Editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Node modules
node_modules/
npm-debug.log
package-lock.json

# Environment files (sensitive data)
.env
.env.local
.env.*.local
.env.*.secret

# OS specific
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db

