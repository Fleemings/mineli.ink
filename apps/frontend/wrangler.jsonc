{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mineli-ink",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,

  "assets": {
    "directory": "./dist/mineli-ink/browser",
    "not_found_handling": "single-page-application"
  },

  "env": {
    "dev": {
      "name": "mineli-ink-dev",
      "workers_dev": true
    }
  }
}