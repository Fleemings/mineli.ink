# Environment variables for Docker production
NODE_ENV=production
PORT=3000

# MongoDB Configuration
MONGO_ROOT_USER=your_secure_user
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGO_INITDB_DATABASE=mineli_ink

# Backend Configuration
BACKEND_PORT=3000
BACKEND_URL=https://api.mineli.ink

# Frontend Configuration
FRONTEND_PORT=80
FRONTEND_URL=https://mineli.ink

# API Configuration
API_TIMEOUT=60000
LOG_LEVEL=warn

