NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://admin:your_mongodb_password_here@mongodb:27017/mineli_ink?authSource=admin
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=your_mongodb_password_here
MONGODB_DATABASE=mineli_ink

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=debug

# Email Configuration
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

